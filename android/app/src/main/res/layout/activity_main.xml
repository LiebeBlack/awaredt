<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Detenido"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Iniciar rastreo" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Optimizar batería (exención)" />

        <!-- ================= Emparejamiento ================= -->
        <TextView style="@style/SectionTitle" android:text="Emparejamiento (Supabase)" />

        <EditText
            android:id="@+id/etSupabaseUrl"
            style="@style/Field" android:hint="URL Supabase (https://xxxx.supabase.co)"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/etSupabaseKey"
            style="@style/Field" android:hint="Clave anon public"
            android:inputType="text" />

        <EditText
            android:id="@+id/etDeviceId"
            style="@style/Field" android:hint="UUID del dispositivo"
            android:inputType="text" />

        <EditText
            android:id="@+id/etDeviceToken"
            style="@style/Field" android:hint="Token de emparejamiento"
            android:inputType="text" />

        <!-- ================= Comportamiento ================= -->
        <TextView style="@style/SectionTitle" android:text="Comportamiento" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Intervalo de reporte" />

        <Spinner
            android:id="@+id/spInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <CheckBox
            android:id="@+id/cbPrecision"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Precision+ (adjuntar celdas/WiFi)" />

        <CheckBox
            android:id="@+id/cbAdaptive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Batería adaptativa (ralentiza en ahorro)" />

        <CheckBox
            android:id="@+id/cbDiscreet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notificación discreta (mínima, siempre visible)" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar configuración" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="12sp"
            android:text="El rastreo funciona solo con tu consentimiento: la notificación permanente es un requisito de Android y te permite detenerlo en cualquier momento."
            android:textColor="#8899A6" />
    </LinearLayout>
</ScrollView>
