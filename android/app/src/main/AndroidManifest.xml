<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Ubicacion hibrida: fina (GPS) y gruesa (red/celdas/WiFi) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Servicio en primer plano de ubicacion (Android 8 a 14) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        Control parental: para listar las apps instaladas solo se declara una
        CONSULTA por el intent LAUNCHER. Android 11+ da visibilidad de las apps
        que coinciden con esta consulta, asi que NO se necesita el permiso
        restringido QUERY_ALL_PACKAGES (el que Google Play limita a antivirus y
        gestores de archivos). Se ven las apps con icono propio, que son
        exactamente las que un menor abre; no se listan paquetes internos ni se
        recoge ningun dato de uso.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!--
            Visibilidad de las dos categorias de RIESGO que revisa la postura:
            sin estas consultas, Android 11+ puede ocultar el paquete y la lista
            saldria vacia sin que signifique que no hay nada (falso negativo en
            justo la parte de seguridad). No hace falta QUERY_ALL_PACKAGES.
        -->
        <intent>
            <action android:name="android.accessibilityservice.AccessibilityService" />
        </intent>
        <intent>
            <action android:name="android.service.notification.NotificationListenerService" />
        </intent>
    </queries>

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <application
        android:name=".LocAgentApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:theme="@style/Theme.Agent">

        <!-- Lanzador VISIBLE por diseno: transparencia del agente ante el usuario -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".sync.LocationService"
            android:exported="false"
            android:foregroundServiceType="location|dataSync" />

        <receiver
            android:name=".sync.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Relanzar tras una actualizacion del APK: el sistema mata el
                     servicio al reemplazar el paquete y nadie lo arrancaria. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            Modo antirrobo (opcional, lo activa el dueño desde la app):
            DeviceAdmin con una unica politica, force-lock (bloqueo remoto de
            pantalla). Android exige desactivarlo antes de desinstalar la app.
            NO se declara wipe-data ni reset-password: nada irreversible.
        -->
        <receiver
            android:name=".admin.AgentDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Watchdog: invocado por PendingIntent explicito (AlarmManager) -->
        <receiver
            android:name=".sync.WatchdogReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- WorkManager: inicializacion manual (sin provider por defecto) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
